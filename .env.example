# Environment — never commit real secrets. Copy to .env and fill in values.

# PostgreSQL (Neon in production; local Docker Compose uses host port 5433)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/legal_metrology?schema=public"

# Auth.js
AUTH_SECRET="generate-a-long-random-string"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Vercel Blob (optional locally — files fall back to .local-storage/)
BLOB_READ_WRITE_TOKEN=""

# Email / SMS providers (optional — messages are logged when unset)
EMAIL_API_KEY=""
SMS_API_KEY=""

# AI assistance (optional; advisory only)
AI_API_KEY=""

# Certificate integrity seal (HMAC). Required in production.
QR_SIGNING_SECRET="generate-another-long-random-string"

# Cron protection. Required in production — cron endpoints refuse all calls without it.
CRON_SECRET="generate-cron-secret"

# Public URL used in QR codes and certificate links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Name printed as the issuing authority on certificates. Set this to the authority that has
# legally adopted the platform; the software itself never claims government issuance.
NEXT_PUBLIC_ISSUING_AUTHORITY="Legal Metrology Verification Authority"

# Shows one-click sign-in buttons for the seeded accounts on the login page. Local only.
NEXT_PUBLIC_SHOW_QUICK_ACCESS="false"

# Password given to every seeded account by `npm run db:seed` (defaults to Verify@2026 when unset).
# Set your own value before seeding any shared environment.
SEED_USER_PASSWORD=""
